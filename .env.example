# Copy these into your IDE run configuration or terminal environment.
# (Spring Boot does NOT read .env files by itself.)
DB_URL=jdbc:mysql://localhost:3306/student_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
# generate with: openssl rand -base64 32
JWT_SECRET=replace_with_base64_secret_of_at_least_32_bytes
JWT_EXPIRATION_MS=3600000
